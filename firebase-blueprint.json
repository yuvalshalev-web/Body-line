{
  "entities": {
    "Member": {
      "title": "Member",
      "description": "A member of the community",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "uid": {
          "type": "string"
        },
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "mobile": {
          "type": "string"
        },
        "avatar": {
          "type": "string"
        },
        "bio": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "Member",
            "Volunteer",
            "Instructor",
            "Admin",
            "Support"
          ]
        },
        "joinedAt": {
          "type": "string"
        },
        "isActive": {
          "type": "boolean"
        },
        "birthday": {
          "type": "string"
        },
        "gender": {
          "type": "string"
        },
        "full_address": {
          "type": "string"
        },
        "certifications": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "otherCertification": {
          "type": "string"
        }
      },
      "required": [
        "firstName",
        "lastName",
        "email",
        "role"
      ]
    },
    "JoinRequest": {
      "title": "JoinRequest",
      "description": "A request to join the community",
      "type": "object",
      "properties": {
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "mobile": {
          "type": "string"
        },
        "requestedAt": {
          "type": "string"
        }
      }
    },
    "GalleryItem": {
      "title": "GalleryItem",
      "description": "An item in the shared gallery",
      "type": "object",
      "properties": {
        "imageUrl": {
          "type": "string"
        },
        "uploaderId": {
          "type": "string"
        },
        "uploaderName": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        },
        "timestamp": {
          "type": "string"
        }
      }
    },
    "Event": {
      "title": "Event",
      "description": "A community event",
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "time": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "COMMUNITY",
            "MEMBER",
            "INSTRUCTOR"
          ]
        }
      }
    },
    "SeaConditions": {
      "title": "SeaConditions",
      "description": "Historical sea conditions data",
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "waveHeight": {
          "type": "number"
        },
        "waterTemp": {
          "type": "number"
        },
        "windSpeed": {
          "type": "number"
        },
        "uvIndex": {
          "type": "number"
        }
      }
    },
    "SeaConditionsStats": {
      "title": "SeaConditionsStats",
      "description": "Historical peaks for sea conditions",
      "type": "object",
      "properties": {
        "maxWaveHeight": {
          "type": "number"
        },
        "minWaveHeight": {
          "type": "number"
        },
        "maxWaterTemp": {
          "type": "number"
        },
        "minWaterTemp": {
          "type": "number"
        },
        "maxWindSpeed": {
          "type": "number"
        },
        "minWindSpeed": {
          "type": "number"
        },
        "maxUvIndex": {
          "type": "number"
        },
        "minUvIndex": {
          "type": "number"
        }
      }
    },
    "PerformanceScore": {
      "title": "PerformanceScore",
      "description": "A monthly performance score for a member",
      "type": "object",
      "properties": {
        "memberId": {
          "type": "string"
        },
        "month": {
          "type": "number"
        },
        "year": {
          "type": "number"
        },
        "paddle": {
          "type": "number"
        },
        "takeOff": {
          "type": "number"
        },
        "turns": {
          "type": "number"
        },
        "positioning": {
          "type": "number"
        },
        "stamina": {
          "type": "number"
        },
        "style": {
          "type": "number"
        },
        "instructorId": {
          "type": "string"
        },
        "instructorName": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "memberId",
        "month",
        "year",
        "paddle",
        "takeOff",
        "turns",
        "positioning",
        "stamina",
        "style"
      ]
    },
    "SurfCall": {
      "title": "SurfCall",
      "description": "User-generated impromptu surf calls",
      "type": "object",
      "properties": {
        "creatorId": {
          "type": "string"
        },
        "creatorName": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "targetBeach": {
          "type": "string"
        },
        "targetDate": {
          "type": "string"
        },
        "targetTime": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "participantsJoined": {
          "type": "array"
        },
        "participantsCancelled": {
          "type": "array"
        },
        "isArchived": {
          "type": "boolean"
        }
      }
    }
  },
  "firestore": {
    "members": {
      "schema": "Member",
      "description": "Collection of community members"
    },
    "joinRequests": {
      "schema": "JoinRequest",
      "description": "Collection of join requests"
    },
    "gallery": {
      "schema": "GalleryItem",
      "description": "Shared gallery items"
    },
    "events": {
      "schema": "Event",
      "description": "Community events"
    },
    "system_logs": {
      "schema": "object",
      "description": "System logs"
    },
    "seaConditions": {
      "schema": "SeaConditions",
      "description": "Historical sea conditions data"
    },
    "seaConditionsStats": {
      "schema": "SeaConditionsStats",
      "description": "Historical peaks for sea conditions"
    },
    "quotes": {
      "schema": "object",
      "description": "Daily quotes"
    },
    "news": {
      "schema": "object",
      "description": "Community news"
    },
    "podcasts": {
      "schema": "object",
      "description": "Community podcasts"
    },
    "glossary": {
      "schema": "object",
      "description": "Surfing glossary"
    },
    "exercises": {
      "schema": "object",
      "description": "Surfing exercises"
    },
    "weekly_history": {
      "schema": "object",
      "description": "Weekly session history"
    },
    "storage_stats": {
      "schema": "object",
      "description": "Database usage statistics"
    },
    "site_data": {
      "schema": "object",
      "description": "Global site configuration and assets (includes staticHeroImage, loginBg, headers, uiImages, and fonts)"
    },
    "admin": {
      "schema": "object",
      "description": "Administrative metadata"
    },
    "rollover_logs": {
      "schema": "object",
      "description": "Logs for weekly session rollovers"
    },
    "performance_scores": {
      "schema": "PerformanceScore",
      "description": "Monthly performance scores for members"
    },
    "surf_calls": {
      "schema": "SurfCall",
      "description": "User-generated impromptu surf calls"
    }
  }
}