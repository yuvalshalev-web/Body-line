rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allow authenticated users to read/write everything
      // This is a temporary measure to debug the unauthorized error
      allow read, write: if request.auth != null;
    }
    
    // Specifically allow assets path for now to ensure admin can upload
    match /assets/{allPaths=**} {
      allow read, write: if true;
    }
  }
}
